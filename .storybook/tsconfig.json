{
  "extends": "../tsconfig.json",
  "compilerOptions": {
    "types": ["node"],
    "baseUrl": "..",
    "paths": {
      "@/*": ["src/*"],
      "@assets/*": ["src/view/assets/*"]
    }
  },
  "include": [
    "../src/**/*.ts",
    "../src/**/*.tsx",
    "../src/**/*.vue",
    "../src/**/*.mdx",
    "../src/**/*.stories.ts",
    "../src/**/*.stories.tsx",
    "../src/**/*.stories.js",
    "../src/**/*.stories.jsx",
    "./main.ts",
    "./preview.ts"
  ]
}
