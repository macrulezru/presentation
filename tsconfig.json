{
  "extends": "@vue/tsconfig/tsconfig.dom.json",
  "include": [
    "env.d.ts",
    "src/**/*",
    "src/**/*.vue",
    "app.vue",
    "pages/**/*",
    "components/**/*",
    "composables/**/*",
    "plugins/**/*",
    "middleware/**/*",
    "server/**/*",
    "nuxt.config.ts",
    "rest-pipeline-js/**/*"
  ],
  "exclude": [
    "src/**/__tests__/*"
  ],
  "compilerOptions": {
    "composite": true,
    "baseUrl": ".",
    "paths": {
      "@/*": ["./src/*"],
      "~/*": ["./*"]
    },
    "types": ["node", "nuxt"],
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "moduleResolution": "bundler",
    "allowSyntheticDefaultImports": true, // ← и эту
    "esModuleInterop": true
  }
}
