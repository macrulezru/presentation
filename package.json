{
  "name": "my-presentation",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "scripts": {
    "css:variables:check": "node ./utils/css-variables-check.js",
    "dev": "vite",
    "dev:network": "vite --host 0.0.0.0 --port 3000",
    "open:android": "powershell -Command \"$adbPath = Join-Path -Path (Resolve-Path .) -ChildPath 'adb/adb.exe'; $ips = @(Get-NetIPAddress -AddressFamily IPv4 | Where-Object { $_.IPAddress -like '192.168.*' } | Select-Object -ExpandProperty IPAddress); $defaultPort = 3000; $port = $defaultPort; try { $viteProc = Get-Process -Name node -ErrorAction SilentlyContinue | Where-Object { $_.MainWindowTitle -like '*VITE*' }; if ($viteProc) { $cmdLine = (Get-CimInstance Win32_Process -Filter \"ProcessId = $($viteProc.Id)\").CommandLine; if ($cmdLine -match '--port (\\d+)') { $port = $matches[1] } } } catch {} if ($ips.Count -eq 1) { $ip = $ips[0]; Write-Host 'Selected IP:' $ip; Write-Host 'Selected Port:' $port; & $adbPath shell am start -a android.intent.action.VIEW -d http://${ip}:${port}/ } elseif ($ips.Count -gt 1) { Write-Warning 'Multiple IP addresses found: ' $ips; Write-Warning 'Please specify the required IP in the script.' } else { Write-Error 'IP address not found' }\"",
    "dev:network:android": "npm-run-all -p dev:network open:android",
    "build": "run-p type-check \"build-only {@}\" --",
    "preview": "vite preview",
    "build-only": "vite build",
    "type-check": "vue-tsc --build --force",
    "storybook": "cross-env STORYBOOK=true storybook dev -p 6006",
    "storybook:build": "cross-env STORYBOOK=true storybook build --output-dir storybook-static",
    "lint": "eslint . --fix --cache",
    "format": "prettier --write .",
    "lint:check": "eslint .",
    "format:check": "prettier --check .",
    "type-check:watch": "vue-tsc --build --watch",
    "i18n:scan": "node utils/scan-i18n-keys.js"
  },
  "dependencies": {
    "@yeger/vue-masonry-wall": "^5.1.4",
    "axios": "^1.13.2",
    "css-magic-gradient": "^1.0.1",
    "emailjs-com": "^3.2.0",
    "pinia": "^3.0.3",
    "prismjs": "^1.30.0",
    "responsive-media": "^1.0.7",
    "rest-pipeline-js": "^1.2.0",
    "stringify-object": "^6.0.0",
    "three": "^0.181.2",
    "vue": "^3.5.22",
    "vue-i18n": "^9.14.5",
    "vue-router": "^4.6.3"
  },
  "devDependencies": {
    "@storybook/addon-a11y": "^8.6.14",
    "@storybook/addon-essentials": "^8.6.14",
    "@storybook/addon-interactions": "^8.6.14",
    "@storybook/blocks": "^8.6.14",
    "@storybook/test": "^8.6.14",
    "@storybook/vue3-vite": "^8.6.14",
    "@tsconfig/node22": "^22.0.2",
    "@types/css": "^0.0.38",
    "@types/node": "^22.18.11",
    "@types/three": "^0.181.0",
    "@typescript-eslint/eslint-plugin": "^8.47.0",
    "@typescript-eslint/parser": "^8.47.0",
    "@vitejs/plugin-vue": "^6.0.1",
    "@vue/eslint-config-prettier": "^10.2.0",
    "@vue/eslint-config-typescript": "^14.6.0",
    "@vue/tsconfig": "^0.8.1",
    "autoprefixer": "^10.4.22",
    "cross-env": "^7.0.3",
    "eslint": "^9.37.0",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-vue": "~10.5.0",
    "jiti": "^2.6.1",
    "npm-run-all2": "^8.0.4",
    "postcss-combine-duplicated-selectors": "^10.0.3",
    "postcss-combine-media-query": "^2.1.0",
    "postcss-html": "^1.8.0",
    "postcss-import": "^16.1.1",
    "postcss-preset-env": "^10.4.0",
    "prettier": "^3.6.2",
    "sass": "^1.95.0",
    "storybook": "^8.6.14",
    "stylelint": "^16.26.1",
    "stylelint-config-recommended-vue": "^1.6.1",
    "stylelint-config-standard-scss": "^16.0.0",
    "stylelint-scss": "^6.13.0",
    "typescript": "~5.9.0",
    "vite": "^7.1.11",
    "vite-plugin-static-copy": "^3.1.4",
    "vite-plugin-svgo": "^2.0.0",
    "vite-plugin-vue-devtools": "^8.0.3",
    "vue-tsc": "^3.1.1"
  }
}
