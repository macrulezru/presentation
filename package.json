{
  "name": "my-presentation",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "scripts": {
    "css:variables:check": "node ./utils/css-variables-check.js",
    "dev": "npm run nuxt:dev",
    "dev:network": "npm run nuxt:dev -- --host 0.0.0.0 --port 3000",
    "open:android": "powershell -Command \"$adbPath = Join-Path -Path (Resolve-Path .) -ChildPath 'adb/adb.exe'; $ips = @(Get-NetIPAddress -AddressFamily IPv4 | Where-Object { $_.IPAddress -like '192.168.*' } | Select-Object -ExpandProperty IPAddress); $defaultPort = 3000; $port = $defaultPort; try { $viteProc = Get-Process -Name node -ErrorAction SilentlyContinue | Where-Object { $_.MainWindowTitle -like '*VITE*' }; if ($viteProc) { $cmdLine = (Get-CimInstance Win32_Process -Filter \"ProcessId = $($viteProc.Id)\").CommandLine; if ($cmdLine -match '--port (\\d+)') { $port = $matches[1] } } } catch {} if ($ips.Count -eq 1) { $ip = $ips[0]; Write-Host 'Selected IP:' $ip; Write-Host 'Selected Port:' $port; & $adbPath shell am start -a android.intent.action.VIEW -d http://${ip}:${port}/ } elseif ($ips.Count -gt 1) { Write-Warning 'Multiple IP addresses found: ' $ips; Write-Warning 'Please specify the required IP in the script.' } else { Write-Error 'IP address not found' }\"",
    "dev:network:android": "npm-run-all -p dev:network open:android",
    "build": "npm run nuxt:build",
    "preview": "npm run nuxt:preview",
    "type-check": "vue-tsc --build --force",
    "lint": "eslint . --fix --cache",
    "format": "prettier --write .",
    "lint:check": "eslint .",
    "format:check": "prettier --check .",
    "type-check:watch": "vue-tsc --build --watch",
    "i18n:scan": "node utils/scan-i18n-keys.js",
    "nuxt:dev": "nuxi dev",
    "nuxt:build": "nuxi build",
    "nuxt:preview": "nuxi preview",
    "i18n:ui": "vue-i18n-kit auto-config && vue-i18n-kit ui"
  },
  "dependencies": {
    "@yeger/vue-masonry-wall": "^5.1.4",
    "axios": "^1.13.2",
    "css-magic-gradient": "^1.0.3",
    "emailjs-com": "^3.2.0",
    "pinia": "^3.0.3",
    "prismjs": "^1.30.0",
    "responsive-media": "^1.0.7",
    "rest-pipeline-js": "^1.2.5",
    "stringify-object": "^6.0.0",
    "three": "^0.181.2",
    "undici": "^7.22.0",
    "vue": "^3.5.22",
    "vue-i18n": "^9.14.5",
    "vue-i18n-kit": "^0.1.8",
    "vue-router": "^4.6.3"
  },
  "devDependencies": {
    "@pinia/nuxt": "^0.11.3",
    "@tsconfig/node22": "^22.0.2",
    "@types/css": "^0.0.38",
    "@types/node": "^22.18.11",
    "@types/three": "^0.181.0",
    "@typescript-eslint/eslint-plugin": "^8.47.0",
    "@typescript-eslint/parser": "^8.47.0",
    "@vitejs/plugin-vue": "^6.0.1",
    "@vue/eslint-config-prettier": "^10.2.0",
    "@vue/eslint-config-typescript": "^14.6.0",
    "@vue/tsconfig": "^0.8.1",
    "autoprefixer": "^10.4.22",
    "eslint": "^9.37.0",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-vue": "~10.5.0",
    "jiti": "^2.6.1",
    "npm-run-all2": "^8.0.4",
    "nuxt": "^4.0.0",
    "postcss-combine-duplicated-selectors": "^10.0.3",
    "postcss-combine-media-query": "^2.1.0",
    "postcss-html": "^1.8.0",
    "postcss-import": "^16.1.1",
    "postcss-preset-env": "^10.4.0",
    "prettier": "^3.6.2",
    "sass": "^1.95.0",
    "stylelint": "^16.26.1",
    "stylelint-config-recommended-vue": "^1.6.1",
    "stylelint-config-standard-scss": "^16.0.0",
    "stylelint-scss": "^6.13.0",
    "typescript": "~5.9.0",
    "vite": "^7.1.11",
    "vite-plugin-static-copy": "^3.1.4",
    "vite-plugin-svgo": "^2.0.0",
    "vite-plugin-vue-devtools": "^8.0.3",
    "vue-tsc": "^3.1.1"
  }
}
